# ── Helm deployment secrets ────────────────────────────────────────────────
# Copy to .env and fill. NEVER commit .env.
# Use a dedicated testnet key with no other purpose.

# Reactive Lasna testnet (chain 5318007) — deploys and pays for reactive txs
REACTIVE_RPC_URL=https://lasna-rpc.rnk.dev/
REACTIVE_PRIVATE_KEY=
REACTIVE_CHAIN_ID=5318007

# Base Sepolia (84532) — HelmVault, mock pools, agent proposals
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_PRIVATE_KEY=

# Unichain Sepolia (1301) — second origin price signal
UNICHAIN_SEPOLIA_RPC_URL=https://sepolia.unichain.org
UNICHAIN_SEPOLIA_PRIVATE_KEY=

# Agent signing key (proposals only; can never move funds)
AGENT_PRIVATE_KEY=

# LLM (Anthropic via Kite Passport, or a direct Anthropic/OpenAI key)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KITE_ALLOWANCE_ENABLED=false

# Operator
OPERATOR_ADDRESS=
